{
  "name": "tgb-cli",
  "version": "1.0.0",
  "description": "淘股吧 (tgb.cn) 命令行工具 - 浏览帖子、搜索、行情、发帖回帖",
  "type": "module",
  "bin": {
    "tgb": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/tgb",
    "typecheck": "bunx tsc --noEmit"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "tgb",
    "taoguba",
    "淘股吧",
    "cli",
    "stock"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
