{
  "name": "tgb-cli",
  "version": "1.0.0",
  "description": "淘股吧 (tgb.cn) 命令行工具 - 浏览帖子、搜索、行情、发帖回帖",
  "type": "module",
  "bin": {
    "tgb": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/tgb",
    "build:win": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile dist/tgb-windows-x64.exe",
    "build:linux": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile dist/tgb-linux-x64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --target=bun-linux-arm64 --outfile dist/tgb-linux-arm64",
    "build:darwin": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/tgb-darwin-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile dist/tgb-darwin-x64",
    "build:all": "bun run build:win && bun run build:linux && bun run build:linux-arm64 && bun run build:darwin && bun run build:darwin-x64",
    "typecheck": "bunx tsc --noEmit"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "tgb",
    "taoguba",
    "淘股吧",
    "cli",
    "stock"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
